from pybricks.hubs import InventorHub
from pybricks.pupdevices import Motor, ColorSensor
from pybricks.parameters import Port, Direction, Stop, Color
from pybricks.robotics import DriveBase
from pybricks.tools import wait

# ----------------------------
# SETUP (Ports anpassen!)
# ----------------------------
hub = InventorHub()

left_motor  = Motor(Port.A, Direction.COUNTERCLOCKWISE)
right_motor = Motor(Port.B, Direction.CLOCKWISE)

cs_left  = ColorSensor(Port.C)
cs_right = ColorSensor(Port.D)

WHEEL_DIAMETER_MM = 56
AXLE_TRACK_MM     = 115
drive = DriveBase(left_motor, right_motor, WHEEL_DIAMETER_MM, AXLE_TRACK_MM)

# ----------------------------
# TUNING (kalibrieren!)
# ----------------------------
REFLECT_LINE_TH = 25           # darunter = Linie (schwarz)
P_GAIN = 2.2
FOLLOW_SPEED = 140             # mm/s
INTERSECTION_CONFIRM_MS = 120  # ms

# Marker (3 Farbstreifen)
STRIPE_STEP_MM = 25
STRIPE_SAMPLES = 6

# Scan-Check
SCAN_CHECK_DISTANCE_MM = 25

# ----------------------------
# Heading (absolute) N/E/S/W
# ----------------------------
N, E, S, W = 0, 1, 2, 3
def left_of(d):  return (d + 3) % 4
def right_of(d): return (d + 1) % 4
def back_of(d):  return (d + 2) % 4

# ----------------------------
# Marker decode: 4 Farben -> base-4 -> 0..63
# ----------------------------
COLOR_DIGIT = {
    Color.RED:    0,
    Color.GREEN:  1,
    Color.BLUE:   2,
    Color.YELLOW: 3
}

def read_color_stable():
    counts = {}
    for _ in range(STRIPE_SAMPLES):
        c1 = cs_left.color()
        c2 = cs_right.color()
        c = c1 if c1 == c2 else c1
        counts[c] = counts.get(c, 0) + 1
        wait(10)

    best, bestn = None, -1
    for c, n in counts.items():
        if n > bestn:
            best, bestn = c, n
    return best

def read_marker_id():
    digits = []
    for i in range(3):
        c = read_color_stable()
        if c not in COLOR_DIGIT:
            raise RuntimeError("Marker-Farbe nicht erkannt: {}".format(c))
        digits.append(COLOR_DIGIT[c])
        if i < 2:
            drive.straight(STRIPE_STEP_MM)

    return digits[0] * 16 + digits[1] * 4 + digits[2]

# ----------------------------
# Line / intersection
# ----------------------------
def intersection_detected():
    return (cs_left.reflection() < REFLECT_LINE_TH) and (cs_right.reflection() < REFLECT_LINE_TH)

def on_line():
    return (cs_left.reflection() < REFLECT_LINE_TH) or (cs_right.reflection() < REFLECT_LINE_TH)

def follow_line_until_intersection():
    drive.reset()
    confirmed = 0

    while True:
        l = cs_left.reflection()
        r = cs_right.reflection()
        err = l - r
        turn = P_GAIN * err

        drive.drive(FOLLOW_SPEED, turn)

        if intersection_detected():
            confirmed += 10
            if confirmed >= INTERSECTION_CONFIRM_MS:
                drive.stop(Stop.BRAKE)
                return drive.distance()
        else:
            confirmed = 0

        wait(10)

def detect_line_ahead_brief():
    # kleiner Vorwärts-Check, ob in der Richtung eine Linie ist
    drive.straight(SCAN_CHECK_DISTANCE_MM)
    has = on_line()
    drive.straight(-SCAN_CHECK_DISTANCE_MM)
    return has

def rotate_to_heading(cur, target):
    diff = (target - cur) % 4
    if diff == 0:
        return cur
    if diff == 1:
        drive.turn(90);  return target
    if diff == 2:
        drive.turn(180); return target
    if diff == 3:
        drive.turn(-90); return target

def scan_exits(cur_heading):
    """
    Liefert absolute headings, die existieren (STRAIGHT/LEFT/RIGHT).
    Wir stehen im Kreuzungszentrum und schauen nach cur_heading.
    """
    exits = []

    # straight
    if detect_line_ahead_brief():
        exits.append(cur_heading)

    # left
    drive.turn(-90)
    if detect_line_ahead_brief():
        exits.append(left_of(cur_heading))
    drive.turn(90)

    # right
    drive.turn(90)
    if detect_line_ahead_brief():
        exits.append(right_of(cur_heading))
    drive.turn(-90)

    return exits

# ----------------------------
# Graph in RAM
# ----------------------------
class GraphMap:
    def __init__(self):
        # node_id -> {"code": marker_code, "edges": {abs_dir: (neighbor_id, dist_mm)}}
        self.nodes = {}
        # marker_code -> node_id
        self.code_to_node = {}
        self.next_node_id = 0

    def get_or_create(self, code):
        if code in self.code_to_node:
            return self.code_to_node[code], False
        nid = self.next_node_id
        self.next_node_id += 1
        self.code_to_node[code] = nid
        self.nodes[nid] = {"code": code, "edges": {}}
        return nid, True

    def add_edge(self, a, d, b, dist):
        self.nodes[a]["edges"][d] = (b, dist)

    def has_edge(self, a, d):
        return d in self.nodes[a]["edges"]

# ----------------------------
# EXPLORE ONLY (DFS + Backtracking)
# ----------------------------
def explore_full_network():
    """
    Erkundet alles, baut Graphen, stoppt wenn alles besucht.
    Annahme: Start steht an einer Kreuzung, Blickrichtung = N.
    """
    graph = GraphMap()
    heading = N

    # Startknoten
    start_code = read_marker_id()
    current, _ = graph.get_or_create(start_code)

    # Stack für Backtracking:
    # Ein Eintrag beschreibt, wie man vom Parent zum Child gekommen ist
    # (parent_node, parent_heading_at_node, child_node, used_dir)
    stack = []

    while True:
        exits = scan_exits(heading)

        # nimm ersten unversuchten Ausgang
        chosen = None
        for d in exits:
            if not graph.has_edge(current, d):
                chosen = d
                break

        if chosen is None:
            # keine neuen Ausgänge -> zurück
            if not stack:
                drive.stop()
                return graph  # fertig erkundet

            parent_node, parent_heading, child_node, used_dir = stack.pop()

            # Wir stehen auf child_node. Zurück Richtung back_of(used_dir)
            heading = rotate_to_heading(heading, back_of(used_dir))

            # Folge Linie bis zur nächsten Kreuzung (= parent)
            _ = follow_line_until_intersection()

            # Marker lesen, current aktualisieren
            code = read_marker_id()
            current = graph.code_to_node.get(code, parent_node)

            # heading wieder so einstellen, wie wir am parent standen
            heading = rotate_to_heading(heading, parent_heading)
            continue

        # gehe chosen Richtung
        heading = rotate_to_heading(heading, chosen)

        # zur nächsten Kreuzung fahren
        dist = follow_line_until_intersection()

        # marker lesen = Zielknoten
        code = read_marker_id()
        nxt, _ = graph.get_or_create(code)

        # Kante hin + zurück speichern
        graph.add_edge(current, chosen, nxt, dist)
        graph.add_edge(nxt, back_of(chosen), current, dist)

        # Stack push (für späteres Zurück)
        stack.append((current, heading, nxt, chosen))

        # vorwärts: current updaten
        current = nxt
        # heading bleibt in Fahrtrichtung

def main():
    g = explore_full_network()

    # Debug-Ausgabe (Hub-Konsole):
    # Zeigt pro Node: code und Kanten
    for nid in g.nodes:
        info = g.nodes[nid]
        print("Node", nid, "code", info["code"], "edges", info["edges"])

main()
